load("//bazel:api.bzl", "modular_py_binary", "requirement")

package(default_visibility = ["//visibility:private"])

modular_py_binary(
    name = "simple_diffusers_generation",
    srcs = ["simple_diffusers_generation.py"],
    tags = ["no-pydeps"],
    deps = [
        requirement("diffusers"),
        requirement("huggingface-hub"),
        requirement("pillow"),
        requirement("torch"),
        requirement("transformers"),
    ],
)
